# ProfitAI Backend Environment Configuration

# Database Configuration
# SQLite (for local development)
DATABASE_URL=sqlite:///./profitai_new.db

# PostgreSQL (for production-like environment)
# DATABASE_URL=postgresql+psycopg://profitai:profitai_local_2024@localhost:5432/profitai

# DeepSeek AI Configuration (via Ethereal Market)
# Get your API key from https://etherealmarket.my.id
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://etherealmarket.my.id/v1
DEEPSEEK_MODEL=auto

# Optional: OpenAI (alternative to DeepSeek)
# OPENAI_API_KEY=your_openai_key_here
