# Copy to local .env; never commit secrets.
APP_ENV=development
APP_NAME=ProfitAI
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
DATABASE_URL=postgresql://profitai:change_me@localhost:5432/profitai
SECRET_KEY=replace_with_local_random_secret
CORS_ORIGINS=http://localhost:3000
# Optional LLM provider settings; keep keys server-side and out of Git.
# Provider yang didukung: deepseek, gemini, openai. Kosongkan untuk auto-detect.
# DeepSeek (opsional; diprioritaskan bila key tersedia).
LLM_PROVIDER=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=1
LLM_MAX_TOKENS=300
LLM_TEMPERATURE=0.3
LLM_CACHE_TTL_SECONDS=300
LLM_RATE_LIMIT_PER_MINUTE=30
